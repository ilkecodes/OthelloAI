# Database (auto-configured by Docker)
DATABASE_URL=postgresql://marketing_user:marketing_password_2024@localhost:5432/marketing_db

# Redis (auto-configured by Docker)
REDIS_URL=redis://localhost:6379/0

# OpenAI (for content generation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Apify (for trend scraping - Instagram + Facebook + LinkedIn)
APIFY_API_TOKEN=your_apify_api_token_here# App Settings
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Environment
ENVIRONMENT=development
DEBUG=True
